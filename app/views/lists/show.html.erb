<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= @list.name %></h1>
  <% if @list.photo.attached? %>

    <%= image_tag @list.photo, width: 500 %>

  <% end %>
  <div>
    <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
    <%= link_to "Back to my lists", lists_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="row">
  <% @list.bookmarks.each do |bookmark| %>
    <div class="col-6">
      <h3><%= bookmark.movie.title %></h3>
      <p><%= bookmark.comment %></p>
      <%= image_tag bookmark.movie.poster_url, width: 300 %>

      <%= link_to "Delete",
                  bookmark_path(bookmark),
                  data: { turbo_method: :delete },
                  class: "btn btn-danger" %>
    </div>
  <% end %>
</div>
